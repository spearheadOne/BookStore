{
  "type": "record",
  "name": "BookMetadataUpserted",
  "namespace": "org.abondar.experimental.bookstore.events.avro",
  "doc": "Snapshot of a book’s searchable metadata after creation or update.",
  "fields": [
    {
      "name": "eventId",
      "doc": "Unique identifier of this event. Reuse it on publication retries so consumers can detect duplicates.",
      "type": {
        "type": "string",
        "logicalType": "uuid"
      }
    },
    {
      "name": "occurredAt",
      "doc": "Persisted update time of the book metadata snapshot, in UTC with millisecond precision.",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      }
    },
    {
      "name": "bookId",
      "doc": "Identifier of the book in Bookstore. Used as the Kafka key for book events.",
      "type": {
        "type": "string",
        "logicalType": "uuid"
      }
    },
    {
      "name": "isbn",
      "doc": "ISBN of the book as stored by Bookstore.",
      "type": "string"
    },
    {
      "name": "title",
      "doc": "Current title of the book.",
      "type": "string"
    },
    {
      "name": "description",
      "doc": "Current book description, or null when the book has none.",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "catalogId",
      "doc": "Identifier of the current catalog, or null when the book has no catalog.",
      "type": [
        "null",
        {
          "type": "string",
          "logicalType": "uuid"
        }
      ],
      "default": null
    }
  ]
}
