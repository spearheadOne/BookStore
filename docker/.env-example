# Shared Docker overrides for both applications.
# Load after the root .env: --env-file .env --env-file docker/.env-example
# Credentials, public Keycloak issuer, bucket and topics stay in the root .env.
# Set KEYCLOAK_AUDIENCE per container: book-service or book-search.
SERVER_PORT=8080
MANAGEMENT_SERVER_PORT=8001

DB_HOST=postgres
REDIS_HOST=redis
KAFKA_BOOTSTRAP_SERVERS=kafka:19092
OPENSEARCH_URL=http://opensearch:9200
BOOK_S3_ENDPOINT=http://seaweedfs:8333

# Keep the public token issuer from the root .env unchanged.
# Fetch keys and health discovery through the existing shared Keycloak internally.
KEYCLOAK_JWK_SET_URI=http://keycloak:8080/realms/bookstore/protocol/openid-connect/certs
KEYCLOAK_HEALTH_DISCOVERY_URI=http://keycloak:8080/realms/bookstore/.well-known/openid-configuration
