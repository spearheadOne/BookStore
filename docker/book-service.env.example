# Runtime configuration for a container on Docker Desktop using the local Compose services.
# Supply with docker run --env-file; these values are not image build arguments.
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=bookstore
DB_USERNAME=book_user
DB_PASSWORD=book_pass
# Optional DB_URL overrides DB_HOST/DB_PORT/DB_NAME.

REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false

KAFKA_BOOTSTRAP_SERVERS=kafka:19092
BOOK_TOPIC=bookstore.book-events
CATALOG_TOPIC=bookstore.catalog-events
# Join the Compose network so Kafka's advertised kafka:19092 address resolves.

# Issuer must match the token; the JWK URL must be reachable from the app container.
KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/bookstore
KEYCLOAK_JWK_SET_URI=http://host.docker.internal:8081/realms/bookstore/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=book-service

BOOK_S3_ENDPOINT=http://host.docker.internal:8333
BOOK_S3_BUCKET=book-store
BOOK_S3_REGION=us-east-1
BOOK_S3_PATH_STYLE=true
BOOK_S3_CONNECT_TIMEOUT=1s
BOOK_S3_REQUEST_TIMEOUT=2m
# The SDK reads credentials from its default provider chain; these are local dev values.
AWS_ACCESS_KEY_ID=book_admin
AWS_SECRET_ACCESS_KEY=book_secret
# For temporary credentials also supply AWS_SESSION_TOKEN.

SERVER_PORT=8080
MANAGEMENT_SERVER_PORT=8001
BOOK_CACHE_TTL=30s
AUTHOR_ID_CACHE_TTL=30s
CATALOG_TTL=30s
BOOK_CONTENT_MAX_FILE_SIZE=100MB
BOOK_CONTENT_MAX_REQUEST_SIZE=110MB
